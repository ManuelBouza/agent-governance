{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "arm_id",
    "pair_id",
    "phase",
    "accepted",
    "first_attempt_accepted",
    "rework_turns",
    "escalation_count",
    "model_effort_speed_sequence",
    "uncached_input_tokens",
    "cached_input_tokens",
    "output_reasoning_tokens",
    "total_tokens",
    "credits",
    "wall_clock_seconds",
    "verification_invocations",
    "verification_level_sequence",
    "changed_paths",
    "scope_violation",
    "cross_arm_access_violation",
    "orchestrator_subject_materialization_bytes",
    "orchestrator_subject_mutation_count",
    "semantic_reentry_count",
    "screening_only"
  ],
  "properties": {
    "arm_id": {
      "type": "string"
    },
    "pair_id": {
      "type": "string"
    },
    "phase": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "first_attempt_accepted": {
      "type": "boolean"
    },
    "rework_turns": {
      "type": "integer",
      "minimum": 0
    },
    "escalation_count": {
      "type": "integer",
      "minimum": 0
    },
    "model_effort_speed_sequence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uncached_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_reasoning_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "credits": {
      "type": "number",
      "minimum": 0
    },
    "wall_clock_seconds": {
      "type": "number",
      "minimum": 0
    },
    "verification_invocations": {
      "type": "integer",
      "minimum": 0
    },
    "verification_level_sequence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_violation": {
      "type": "boolean"
    },
    "cross_arm_access_violation": {
      "type": "boolean"
    },
    "orchestrator_subject_materialization_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "orchestrator_subject_mutation_count": {
      "type": "integer",
      "minimum": 0
    },
    "semantic_reentry_count": {
      "type": "integer",
      "minimum": 0
    },
    "screening_only": {
      "const": true
    }
  }
}
