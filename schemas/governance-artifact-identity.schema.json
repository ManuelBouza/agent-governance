{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance.local/schemas/governance-artifact-identity.schema.json",
  "title": "Agent Governance Artifact Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_schema_version",
    "skill_version",
    "protocol_version",
    "installed_footprint_version",
    "source_commit",
    "files",
    "payload_digest",
    "identity_digest"
  ],
  "properties": {
    "build_schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "skill_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "protocol_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "installed_footprint_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
